* text=auto

# Keep repository text files in LF across platforms
*.md text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.env text eol=lf

# Preserve Windows scripts in CRLF when needed
*.bat text eol=crlf
*.cmd text eol=crlf
